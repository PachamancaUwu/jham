@model jhampro.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="container mt-5" style="max-width:500px">
    <div class="card">
        <div class="card-body">
            <h3 class="mb-3">Restablecer contraseña</h3>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            <form asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="Token" />

                <div class="mb-3">
                    <label asp-for="NuevaContrasena" class="form-label">Nueva contraseña</label>
                    <input asp-for="NuevaContrasena" class="form-control" type="password" />
                    <span asp-validation-for="NuevaContrasena" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="RepetirContrasena" class="form-label">Repetir contraseña</label>
                    <input asp-for="RepetirContrasena" class="form-control" type="password" />
                    <span asp-validation-for="RepetirContrasena" class="text-danger small"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Restablecer contraseña</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
