@model jhampro.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Restablecer Contraseña";
}
<link rel="stylesheet" href="~/css/stylelogin.css" asp-append-version="true" />

<div class="login-container">
    <h2>REESTABLECER CONTRASEÑA</h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            Hubo errores al procesar tu solicitud.
        </div>
    }

    <form asp-action="RestablecerContrasena" method="post">
        @Html.AntiForgeryToken()

        <!-- Campos ocultos -->
        <input type="hidden" asp-for="Token" />
        <input type="hidden" asp-for="Email" />

        <div class="form-group">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" class="form-control" type="password" required />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" required />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-login">Guardar nueva contraseña</button>

        <a href="/Login/Login" class="register-link">Volver al inicio de sesión</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
